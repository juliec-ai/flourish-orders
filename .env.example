# Infinity API token (Profile > Developer > Tokens). Server only, never sent to the browser.
INFINITY_TOKEN=

# Brigham Floral (BRGM) workspace and the order boards
INFINITY_WORKSPACE=62514
CUSTOMERS_BOARD=692YNE7vaYz
PRODUCTS_BOARD=ar2atxGwR7m
ORDERS_BOARD=9VF3MFPmMZL

# Long random string used to sign login cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Staff logins as JSON. Make each entry with: npm run hash-pin -- "Name" email@example.com 1234
# Optional "infinityUserId" fills the Orders "Taken By" member field.
STAFF_USERS=[]

# Sales tax rate as a decimal (for example 0.0725). Applied to taxable items.
TAX_RATE=0
# Default delivery fee in dollars
DELIVERY_FEE=0
# Brand pre-selected on new orders: Brigham Floral and Gift, Flourish, or David Isaac
DEFAULT_BRAND=Brigham Floral and Gift
# Shop time zone, used for order numbers and "today"
TZ=America/Denver

PORT=3000
